rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      // Usando o e-mail do admin como hardcoded para facilidade nesse cenário, ou um documento de admins.
      // E-mail do user é literado na request:
      return request.auth != null && request.auth.token.email == 'liberacaoconnectpro@gmail.com' && request.auth.token.email_verified == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validação estrita do modelo completo
    function isValidLicenca(data) {
      return data.keys().hasAll(['status', 'validade', 'device_id', 'clienteNome', 'sistema', 'userId'])
        && data.keys().size() == 6
        && data.status is bool
        && data.validade is number // Timestamp ms
        && data.device_id is string && data.device_id.size() <= 200
        && data.clienteNome is string && data.clienteNome.size() >= 1 && data.clienteNome.size() <= 100
        && data.sistema is string && data.sistema.matches('^(Fisio|PetShop)$')
        && data.userId is string && data.userId.size() <= 128;
    }

    match /licencas/{licencaId} {
      allow read: if isValidId(licencaId) && (isAdmin() || isOwner(licencaId));
      allow delete: if isValidId(licencaId) && isAdmin();
      
      allow create: if isValidId(licencaId) 
        && isAdmin() 
        && isValidLicenca(incoming()) 
        && incoming().userId == licencaId;

      allow update: if isValidId(licencaId) && isSignedIn() && (
        (isAdmin() && isValidLicenca(incoming())) ||
        (
          isOwner(licencaId) &&
          existing().device_id == '' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['device_id']) &&
          incoming().device_id is string &&
          incoming().device_id.size() > 0 &&
          incoming().device_id.size() <= 200
        )
      );

      allow list: if isAdmin(); // users typically don't list, they get their own via doc(db, 'licencas', uid)
    }
  }
}
